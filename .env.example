# EcoCampus MVP — Environment Configuration
# Copy this file to .env and adjust variables as needed

# Host and Port binding
HOST=0.0.0.0
PORT=5501

# Debug mode (0 = production / disabled, 1 = development)
FLASK_DEBUG=0

# Database storage path (defaults to local ecocampus.db in project folder)
# In Docker or Cloud persistent volumes, e.g. /data/ecocampus.db
DATABASE_PATH=ecocampus.db

# CORS Allowed Origins (* or https://yourdomain.com)
CORS_ORIGINS=*

# First administrator account (password must be 1-8 characters).
# Leave blank to disable bootstrap admin creation; registered accounts remain standard users.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Optional explicit Flask session signing secret; if blank, a random key is stored in the database.
# Set a stable secret in deployments that share the database across application instances.
SESSION_SECRET_KEY=
SESSION_COOKIE_SECURE=0

# Monitoring defaults: max limit = historical average * multiplier;
# under-usage means actual is below average * ratio.
MONITORING_LIMIT_MULTIPLIER=1.5
MONITORING_UNDER_USAGE_RATIO=0.5

# Optional resource limits used only when no historical average exists, as JSON.
# Example: {"electricity":400,"water":2000}
MONITORING_BASELINE_LIMITS={}
