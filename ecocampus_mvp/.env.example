# EcoCampus MVP — Environment Configuration
# Copy this file to .env and adjust variables as needed

# Host and Port binding
HOST=0.0.0.0
PORT=5501

# Debug mode (0 = production / disabled, 1 = development)
FLASK_DEBUG=0

# Database storage path (defaults to local ecocampus.db in project folder)
# In Docker or Cloud persistent volumes, e.g. /data/ecocampus.db
DATABASE_PATH=ecocampus.db

# CORS Allowed Origins (* or https://yourdomain.com)
CORS_ORIGINS=*
